# AI provider adapter: mock | openai
AI_PROVIDER=mock
# Model name for the selected provider (e.g. gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# Secret API key (never commit). Required only for real providers.
AI_API_KEY=
# Optional base URL for OpenAI-compatible endpoints
AI_BASE_URL=https://api.openai.com/v1
# SQLite connection string
DATABASE_URL=sqlite:///lead_assistant.db
# local | test
APP_ENV=local
# Days without contact before an open lead is considered stale
STALE_DAYS=7
# Hours within which a new lead is considered "new hot"
NEW_LEAD_WINDOW_HOURS=48
